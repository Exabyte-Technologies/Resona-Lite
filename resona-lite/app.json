{
  "expo": {
    "name": "Resona Lite",
    "slug": "resona-lite",
    "scheme": "resona-lite",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/resona-icon-gradient.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.resona.lite",
      "buildNumber": "4",
      "supportsTablet": true,
      "infoPlist": {
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "en",
          "zh-Hans",
          "zh-Hant",
          "es",
          "hi",
          "ar",
          "pt",
          "fr",
          "ru",
          "ja"
        ],
        "CFBundleDevelopmentRegion": "en"
      }
    },
    "android": {
      "package": "com.resona.lite",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#101a1c",
        "foregroundImage": "./assets/resona-icon-gradient.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/resona-icon-gradient.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101a1c",
          "image": "./assets/resona-icon-gradient.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.resona.lite",
          "enablePushNotifications": false,
          "bundleIdentifier": "com.resona.lite.ExpoWidgetsTarget"
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#83c9bd"
        }
      ],
      "./plugins/with-resona-playback"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5dad582a-0757-44cd-845d-e42f6ac3cc3f"
      }
    }
  }
}
