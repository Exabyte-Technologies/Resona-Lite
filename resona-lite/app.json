{
  "expo": {
    "name": "Resona Lite",
    "slug": "resona-lite",
    "scheme": "resona-lite",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/resona-icon-padded.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.resona.lite",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.resona.lite",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#f4f7f3",
        "foregroundImage": "./assets/resona-icon-padded.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/resona-icon-padded.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5dad582a-0757-44cd-845d-e42f6ac3cc3f"
      }
    }
  }
}
